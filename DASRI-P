-- Animation du loading
task.spawn(function()
    for i = 0, 100 do
        local progress = i / 100
        ProgressBar.Size = UDim2.new(progress, 0, 1, 0)
        PercentLabel.Text = i .. "%"
        
        if i == 25 then SubTitle.Text = "LOADING MODULES..." end
        if i == 50 then SubTitle.Text = "INJECTING..." end
        if i == 75 then SubTitle.Text = "ALMOST READY..." end
        if i == 100 then SubTitle.Text = "DONE !" end
        
        task.wait(0.018)
    end
    
    task.wait(0.4)
    
    -- Fade out loading
    TweenService:Create(LoadingFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    }):Play()
    
    for _, v in pairs(LoadingFrame:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("Frame") then
            TweenService:Create(v, TweenInfo.new(0.5), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        end
    end
    
    task.wait(0.7)
    LoadingFrame:Destroy()
    
    -- Apparition du panel
    MainFrame.Visible = true
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back), {
        Size = UDim2.new(0, 380, 0, 420)
    }):Play()
end)

