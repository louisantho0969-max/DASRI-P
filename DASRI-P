local Players = game:GetService("Players")
local player = Players.LocalPlayer

local KEY = "5377-HACK"
local DISCORD_LINK = "https://discord.gg/vxd3pA97n"

-- Fenêtre Key
local gui = Instance.new("ScreenGui")
gui.Name = "KeySystem"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(350, 210)
frame.Position = UDim2.fromScale(0.5, 0.5)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.Text = "KEY SYSTEM"
title.TextScaled = true
title.Parent = frame

local keyBox = Instance.new("TextBox")
keyBox.Size = UDim2.new(1, -30, 0, 40)
keyBox.Position = UDim2.fromOffset(15, 55)
keyBox.PlaceholderText = "Enter your key"
keyBox.ClearTextOnFocus = false
keyBox.Parent = frame

local enter = Instance.new("TextButton")
enter.Size = UDim2.fromOffset(150, 40)
enter.Position = UDim2.fromOffset(15, 105)
enter.Text = "ENTER"
enter.Parent = frame

local getKey = Instance.new("TextButton")
getKey.Size = UDim2.fromOffset(150, 40)
getKey.Position = UDim2.fromOffset(185, 105)
getKey.Text = "GET KEY"
getKey.Parent = frame

local close = Instance.new("TextButton")
close.Size = UDim2.new(1, -30, 0, 35)
close.Position = UDim2.fromOffset(15, 155)
close.Text = "CLOSE"
close.Parent = frame

-- GET KEY
getKey.MouseButton1Click:Connect(function()
    keyBox.Text = DISCORD_LINK
    keyBox:CaptureFocus()
end)

-- CLOSE
close.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

-- ENTER
enter.MouseButton1Click:Connect(function()

    if keyBox.Text == KEY then

        gui:Destroy()

        -- =====================================
        -- DEUXIÈME SYSTÈME
        -- =====================================

        -- Le code de ton deuxième système
        -- doit être placé ici.

        print("Système principal ouvert !")

    else

        keyBox.Text = ""
        keyBox.PlaceholderText = "Key incorrecte !"

    end
end)
