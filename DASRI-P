-- Fonction pour créer des boutons stylés
local function CreateButton(text, color, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 44)
    Btn.BackgroundColor3 = Color3.fromRGB(28, 24, 40)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(220, 200, 255)
    Btn.TextSize = 15
    Btn.Font = Enum.Font.GothamBold
    Btn.AutoButtonColor = false
    Btn.Parent = ButtonsContainer
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 10)
    Corner.Parent = Btn
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = color
    Stroke.Thickness = 1.2
    Stroke.Transparency = 0.5
    Stroke.Parent = Btn
    
    Btn.MouseEnter:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 35, 70)}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Transparency = 0.1}):Play()
    end)
    
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 24, 40)}):Play()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
    end)
    
    Btn.MouseButton1Click:Connect(callback)
    
    return Btn
end

