--==================================================
-- FLY PANEL
--==================================================

local function createFlyPanel()

	local gui = Instance.new("ScreenGui")
	gui.Name = "FlyPanel"
	gui.ResetOnSpawn = false
	gui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(250, 220)
	frame.Position = UDim2.new(0.5, -125, 0.25, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.Parent = gui

	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 40)
	title.BackgroundTransparency = 1
	title.Text = "🌈 Fly Panel"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.Parent = frame

	local fly = Instance.new("TextButton")
	fly.Size = UDim2.new(0.8, 0, 0, 45)
	fly.Position = UDim2.new(0.1, 0, 0.25, 0)
	fly.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
	fly.Text = "FLY ON"
	fly.TextColor3 = Color3.new(1, 1, 1)
	fly.Font = Enum.Font.GothamBold
	fly.TextScaled = true
	fly.Parent = frame

	Instance.new("UICorner", fly).CornerRadius = UDim.new(0, 10)

	local jump = Instance.new("TextButton")
	jump.Size = UDim2.new(0.8, 0, 0, 45)
	jump.Position = UDim2.new(0.1, 0, 0.50, 0)
	jump.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
	jump.Text = "INFINITE JUMP ON"
	jump.TextColor3 = Color3.new(1, 1, 1)
	jump.Font = Enum.Font.GothamBold
	jump.TextScaled = true
	jump.Parent = frame

	Instance.new("UICorner", jump).CornerRadius = UDim.new(0, 10)

	local closePanel = Instance.new("TextButton")
	closePanel.Size = UDim2.new(0.8, 0, 0, 35)
	closePanel.Position = UDim2.new(0.1, 0, 0.76, 0)
	closePanel.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	closePanel.Text = "CLOSE"
	closePanel.TextColor3 = Color3.new(1, 1, 1)
	closePanel.Font = Enum.Font.GothamBold
	closePanel.TextScaled = true
	closePanel.Parent = frame

	Instance.new("UICorner", closePanel).CornerRadius = UDim.new(0, 10)

	-- Fly
	local flying = false
	local flyConnection

	fly.MouseButton1Click:Connect(function()

		flying = not flying

		if flying then
			fly.Text = "FLY OFF"
			fly.BackgroundColor3 = Color3.fromRGB(170, 0, 0)

			flyConnection = RunService.RenderStepped:Connect(function()

				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local root = character and character:FindFirstChild("HumanoidRootPart")

				if not humanoid or not root then
					return
				end

				root.AssemblyLinearVelocity =
					humanoid.MoveDirection * 50
			end)

		else
			fly.Text = "FLY ON"
			fly.BackgroundColor3 = Color3.fromRGB(0, 170, 0)

			if flyConnection then
				flyConnection:Disconnect()
				flyConnection = nil
			end
		end
	end)

	-- Infinite Jump
	local infiniteJump = false
	local jumpConnection

	jump.MouseButton1Click:Connect(function()

		infiniteJump = not infiniteJump

		if infiniteJump then
			jump.Text = "INFINITE JUMP OFF"
			jump.BackgroundColor3 = Color3.fromRGB(170, 0, 0)

			jumpConnection = UserInputService.JumpRequest:Connect(function()

				if not infiniteJump then
					return
				end

				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")

				if humanoid then
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end)

		else
			jump.Text = "INFINITE JUMP ON"
			jump.BackgroundColor3 = Color3.fromRGB(0, 120, 255)

			if jumpConnection then
				jumpConnection:Disconnect()
				jumpConnection = nil
			end
		end
	end)

	closePanel.MouseButton1Click:Connect(function()

		if flyConnection then
			flyConnection:Disconnect()
		end

		if jumpConnection then
			jumpConnection:Disconnect()
		end

		gui:Destroy()
	end)
end

