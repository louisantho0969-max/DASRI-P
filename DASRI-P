-- GET KEY
--==================================================

getKey.MouseButton1Click:Connect(function()

	keyBox.Text = DISCORD_LINK
	keyBox:CaptureFocus()
	keyBox.CursorPosition = #DISCORD_LINK + 1

	status.Text = "Discord link inserted."
	status.TextColor3 = Color3.fromRGB(180, 180, 255)
end)
