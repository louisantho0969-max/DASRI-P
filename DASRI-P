-- KEY SYSTEM + TON SCRIPT
-- À utiliser dans ton propre jeu Roblox

local Players = game:GetService("Players")
local player = Players.LocalPlayer

local CORRECT_KEY = "5377-HACK"

-- =========================
-- CRÉATION DE LA FENÊTRE
-- =========================

local gui = Instance.new("ScreenGui")
gui.Name = "KeySystem"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(330, 200)
frame.Position = UDim2.fromScale(0.5, 0.5)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 45)
title.Text = "KEY SYSTEM"
title.TextScaled = true
title.Parent = frame

local keyBox = Instance.new("TextBox")
keyBox.Size = UDim2.new(1, -30, 0, 40)
keyBox.Position = UDim2.fromOffset(15, 55)
keyBox.PlaceholderText = "Enter Key"
keyBox.ClearTextOnFocus = false
keyBox.Parent = frame

local enterButton = Instance.new("TextButton")
enterButton.Size = UDim2.fromOffset(140, 40)
enterButton.Position = UDim2.fromOffset(15, 110)
enterButton.Text = "ENTER"
enterButton.Parent = frame

local getKeyButton = Instance.new("TextButton")
getKeyButton.Size = UDim2.fromOffset(140, 40)
getKeyButton.Position = UDim2.fromOffset(175, 110)
getKeyButton.Text = "GET KEY"
getKeyButton.Parent = frame

local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(1, -30, 0, 30)
closeButton.Position = UDim2.fromOffset(15, 155)
closeButton.Text = "CLOSE"
closeButton.Parent = frame

local message = Instance.new("TextLabel")
message.Size = UDim2.new(1, -30, 0, 25)
message.Position = UDim2.fromOffset(15, 180)
message.Text = ""
message.Parent = frame

-- =========================
-- GET KEY
-- =========================

getKeyButton.MouseButton1Click:Connect(function()
    -- Ajoute ici le système de récupération
    -- de clé de TON jeu.
    message.Text = "Va chercher ta clé."
end)

-- =========================
-- CLOSE
-- =========================

closeButton.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

-- =========================
-- VÉRIFICATION
-- =========================

enterButton.MouseButton1Click:Connect(function()

    if keyBox.Text == CORRECT_KEY then

        gui:Destroy()

        -- =========================
        -- TON SYSTÈME COMMENCE ICI
        -- =========================

        print("Clé correcte !")

        -- Mets ici le code de ton propre système.

    else

        message.Text = "Clé incorrecte."

    end
end)
