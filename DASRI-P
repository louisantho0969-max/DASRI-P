-- Petit Panel Multicolore + A3K Toggle (Delta Executor)
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RainbowA3KPanel"
screenGui.Parent = playerGui
screenGui.ResetOnSpawn = false

-- Frame principale
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Parent = screenGui
mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
mainFrame.BorderSizePixel = 0
mainFrame.Position = UDim2.new(0.4, 0, 0.35, 0)
mainFrame.Size = UDim2.new(0, 220, 0, 110)
mainFrame.Active = true
mainFrame.Draggable = true

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 12)
uiCorner.Parent = mainFrame

-- Titre
local title = Instance.new("TextLabel")
title.Name = "Title"
title.Parent = mainFrame
title.BackgroundTransparency = 1
title.Size = UDim2.new(1, 0, 0, 35)
title.Font = Enum.Font.GothamBold
title.Text = "🌈 A3K Panel"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true

-- Bouton Fermer (X)
local closeButton = Instance.new("TextButton")
closeButton.Name = "CloseButton"
closeButton.Parent = mainFrame
closeButton.BackgroundColor3 = Color3.fromRGB(220, 30, 30)
closeButton.Position = UDim2.new(1, -28, 0, 5)
closeButton.Size = UDim2.new(0, 23, 0, 23)
closeButton.Font = Enum.Font.GothamBold
closeButton.Text = "X"
closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
closeButton.TextScaled = true

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeButton

-- Bouton A3K ON/OFF
local a3kButton = Instance.new("TextButton")
a3kButton.Name = "A3KButton"
a3kButton.Parent = mainFrame
a3kButton.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
a3kButton.Position = UDim2.new(0.1, 0, 0.45, 0)
a3kButton.Size = UDim2.new(0.8, 0, 0, 45)
a3kButton.Font = Enum.Font.GothamSemibold
a3kButton.Text = "A3K ON"
a3kButton.TextColor3 = Color3.fromRGB(255, 255, 255)
a3kButton.TextScaled = true

local a3kCorner = Instance.new("UICorner")
a3kCorner.CornerRadius = UDim.new(0, 10)
a3kCorner.Parent = a3kButton

-- Variables
local a3kLoaded = false
local a3kActive = false

-- Effet rainbow
task.spawn(function()
    while mainFrame.Parent do
        for i = 0, 1, 0.015 do
            if not mainFrame.Parent then break end
            local color = Color3.fromHSV(i, 1, 1)
            mainFrame.BorderColor3 = color
            title.TextColor3 = color
            task.wait(0.03)
        end
    end
end)

-- Charger le script A3K
local function loadA3K()
    if a3kLoaded then return end
    a3kLoaded = true
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/N1ghtCLAWZ/NightCLAWZ/refs/heads/main/Script"))()
    end)
end

-- Toggle A3K
a3kButton.MouseButton1Click:Connect(function()
    a3kActive = not a3kActive
    if a3kActive then
        a3kButton.Text = "A3K OFF"
        a3kButton.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
        loadA3K() -- Active le script
    else
        a3kButton.Text = "A3K ON"
        a3kButton.BackgroundColor3 = Color3.fromRGB(0, 170, 80)
        -- Note : le script est obfusqué, donc pas de vrai "off" propre
        -- Le panel reste ouvert
    end
end)

-- Fermer le panel
closeButton.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Notification
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Rainbow A3K Panel",
    Text = "Panel chargé ! Clique sur A3K pour activer.",
    Duration = 4
})

print("✅ Rainbow A3K Panel chargé avec succès !")
